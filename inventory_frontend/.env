# #JWTKEY=
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DB_NAME=postgres
# JWT Secret Key (for authentication)
REACT_APP_JWT_KEY=your_jwt_secret_key #  Important: Replace with a strong, random secret

# Database connection details (PostgreSQL)
REACT_APP_DB_USERNAME=postgres
REACT_APP_DB_PASSWORD=1234
REACT_APP_DB_NAME=SM
REACT_APP_DB_HOST=localhost #  Add this if your DB is not on localhost
REACT_APP_DB_PORT=5432    #  Add this if your DB is not on the default port
REACT_APP_API_URL=http://localhost:4000
